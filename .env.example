# .env.example — Vercel + Neon (PostgreSQL) uchun
# Bu faylni .env.local nomi bilan nusxa oling va to'ldiring.
# HECH QACHON haqiqiy parollarni git ga push qilmang!

# ─── Neon PostgreSQL ───────────────────────────────────────────
# Neon dashboard → Project → Connection string → Pooled connection (pgbouncer):
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require&pgbouncer=true"
# Neon dashboard → Direct connection (migrations uchun):
DIRECT_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require"

# ─── Ilova sozlamalari ─────────────────────────────────────────
# Vercel deployment URL yoki o'z domeningiz:
APP_ORIGIN="https://shomanay.vercel.app"

# demo: mockData ishlatiladi; production: faqat baza ishlatiladi
DATA_MODE="demo"

# ─── Foydalanuvchi hisoblari ───────────────────────────────────
# Har bir parol kamida 16 ta belgidan iborat bo'lishi shart!
# Role: admin | hokim | coordinator | organization | inspector | statistician
AUTH_USERS='[
  {"username":"admin","password":"KUCHLI_PAROL_16+","role":"admin","name":"Administrator","organization":"Shomanay"},
  {"username":"hokim","password":"BOSHQA_PAROL_16+","role":"hokim","name":"Hokim","organization":"Shomanay hokimligi"}
]'
